generator client {
  provider = "prisma-client"
  output = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Auth {
  id        String @id @default(uuid())
  userId    String @unique
  serviceId String @unique

  tokenHashed Boolean @default(false)

  accessToken  String
  refreshToken String?
  password     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserStatus {
  OFFLINE
  INACTIVE
  DONOTDISTURB
  ONLINE
}

model User {
  id String @id @default(uuid())

  nickname String
  username String @unique

  avatar String?
  bio    String?

  isProfilePublic Boolean    @default(true)
  status          UserStatus @default(OFFLINE)
  lastSeenAt      DateTime?  @default(now())

  chats String[] @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

enum ChatType {
  DIRECT
  GROUP
  SELF
}

model Chat {
  id       String  @id @default(uuid())
  name     String
  chatname String? @unique
  ownerId  String

  icon String?

  type ChatType @default(GROUP)

  rights Json @default("{}")

  members  String[] @default([])
  messages String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id   String @id @default(uuid())
  text String

  senderId String
  chatId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId, createdAt])
  @@index([senderId, createdAt])
}