generator client {
  provider = "prisma-client"
  output = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model AuthUser {
  id        String @id @default(uuid())
  serviceId String @unique
  profileId String @unique

  accessToken  String
  refreshToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserStatus {
  OFFLINE
  INACTIVE
  DONOTDISTURB
  ONLINE
}

model User {
  id String @id @default(uuid())

  nickname String
  username String @unique

  avatar String?
  bio    String?

  isProfilePublic Boolean    @default(true)
  status          UserStatus @default(OFFLINE)
  lastSeenAt      DateTime?  @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  chats Chat[]
}

enum ChatType {
  DIRECT
  GROUP
}

model Chat {
  id       String  @id @default(uuid())
  name     String
  chatname String? @unique
  ownerId  String

  type ChatType @default(GROUP)

  rights Json?

  members  User[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id   String @id @default(uuid())
  text String

  senderId String

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  deliveredTo String[]
  readedBy    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId, createdAt])
  @@index([senderId, createdAt])
}
